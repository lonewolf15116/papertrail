# Copy to .env and fill in. .env is git-ignored.
PAPERTRAIL_DATABASE_URL=postgresql://papertrail:papertrail@localhost:5432/papertrail
# LLM backend for answers and the faithfulness judge: "anthropic" (default) or "openai".
# PAPERTRAIL_LLM_PROVIDER=openai
# Set the key for the provider you use. Never commit a real key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# PAPERTRAIL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# PAPERTRAIL_TOP_K=5
# Leave the models blank to use the provider's defaults (config.py); prices are USD per million tokens.
# PAPERTRAIL_LLM_MODEL=
# PAPERTRAIL_JUDGE_MODEL=       # keep it different from the answer model
# PAPERTRAIL_JUDGE_PROVIDER=    # blank = same provider as the answers
# PAPERTRAIL_LLM_INPUT_PRICE_PER_MTOK=
# PAPERTRAIL_LLM_OUTPUT_PRICE_PER_MTOK=
